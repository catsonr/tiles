[configuration]

entry_symbol = "tiles_library_init"
compatibility_minimum = "4.7"
reloadable = true

[libraries]

macos.single.debug = "res://bin/macos/libtiles.macos.template_debug.dylib"
macos.single.release = "res://bin/macos/libtiles.macos.template_release.dylib"

windows.x86_64.single.debug = "res://bin/windows/tiles.windows.template_debug.x86_64.dll"
windows.x86_64.single.release = "res://bin/windows/tiles.windows.template_release.x86_64.dll"

linux.x86_64.single.debug = "res://bin/linux/libtiles.linux.template_debug.x86_64.so"
linux.x86_64.single.release = "res://bin/linux/libtiles.linux.template_release.x86_64.so"

linux.arm64.single.debug = "res://bin/linux/libtiles.linux.template_debug.arm64.so"
linux.arm64.single.release = "res://bin/linux/libtiles.linux.template_release.arm64.so"
